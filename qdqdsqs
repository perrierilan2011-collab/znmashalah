local ESPDrawings = {}

local function GetSkeletonParts(character)
    local parts = {}
    if not character then return parts end

    local head = character:FindFirstChild("Head")
    local torso = character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
    local lowerTorso = character:FindFirstChild("LowerTorso") or character:FindFirstChild("Torso")

    if head and torso then
        table.insert(parts, {head, torso})
    end

    if torso then
        local leftArm = character:FindFirstChild("Left Arm") or character:FindFirstChild("LeftUpperArm")
        local rightArm = character:FindFirstChild("Right Arm") or character:FindFirstChild("RightUpperArm")
        local leftLeg = character:FindFirstChild("Left Leg") or character:FindFirstChild("LeftUpperLeg")
        local rightLeg = character:FindFirstChild("Right Leg") or character:FindFirstChild("RightUpperLeg")

        if leftArm then table.insert(parts, {torso, leftArm}) end
        if rightArm then table.insert(parts, {torso, rightArm}) end

        if lowerTorso then
            if leftLeg then table.insert(parts, {lowerTorso, leftLeg}) end
            if rightLeg then table.insert(parts, {lowerTorso, rightLeg}) end

            if torso ~= lowerTorso then
                table.insert(parts, {torso, lowerTorso})
            end
        end

        -- R15 additional parts
        local leftLowerArm = character:FindFirstChild("LeftLowerArm")
        local rightLowerArm = character:FindFirstChild("RightLowerArm")
        local leftHand = character:FindFirstChild("LeftHand")
        local rightHand = character:FindFirstChild("RightHand")
        local leftLowerLeg = character:FindFirstChild("LeftLowerLeg")
        local rightLowerLeg = character:FindFirstChild("RightLowerLeg")
        local leftFoot = character:FindFirstChild("LeftFoot")
        local rightFoot = character:FindFirstChild("RightFoot")

        if leftLowerArm and leftHand then table.insert(parts, {leftLowerArm, leftHand}) end
        if rightLowerArm and rightHand then table.insert(parts, {rightLowerArm, rightHand}) end
        if leftLowerLeg and leftFoot then table.insert(parts, {leftLowerLeg, leftFoot}) end
        if rightLowerLeg and rightFoot then table.insert(parts, {rightLowerLeg, rightFoot}) end

        local leftUpperArm = character:FindFirstChild("LeftUpperArm")
        local rightUpperArm = character:FindFirstChild("RightUpperArm")
        local leftUpperLeg = character:FindFirstChild("LeftUpperLeg")
        local rightUpperLeg = character:FindFirstChild("RightUpperLeg")

        if leftUpperArm and leftLowerArm then table.insert(parts, {leftUpperArm, leftLowerArm}) end
        if rightUpperArm and rightLowerArm then table.insert(parts, {rightUpperArm, rightLowerArm}) end
        if leftUpperLeg and leftLowerLeg then table.insert(parts, {leftUpperLeg, leftLowerLeg}) end
        if rightUpperLeg and rightLowerLeg then table.insert(parts, {rightUpperLeg, rightLowerLeg}) end
    end

    return parts
end

local function ClearESPForPlayer(player)
    if ESPDrawings[player] then
        for _, drawings in pairs(ESPDrawings[player]) do
            if type(drawings) == "table" then
                for _, d in pairs(drawings) do
                    pcall(function() d:Remove() end)
                end
            else
                pcall(function() drawings:Remove() end)
            end
        end
        ESPDrawings[player] = nil
    end
end

local function UpdateESPForPlayer(player)
    if not ESPConfig.Enabled then
        ClearESPForPlayer(player)
        return
    end

    local character = player.Character
    if not character then
        ClearESPForPlayer(player)
        return
    end

    local root = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChild("Humanoid")
    if not root or not humanoid or humanoid.Health <= 0 then
        ClearESPForPlayer(player)
        return
    end

    if ESPConfig.TeamCheck and player.Team == LocalPlayer.Team then
        ClearESPForPlayer(player)
        return
    end

    local rootPos, onScreen = Camera:WorldToViewportPoint(root.Position)
    if not onScreen then
        ClearESPForPlayer(player)
        return
    end

    local distance = (Camera.CFrame.Position - root.Position).Magnitude
    if distance > ESPConfig.MaxDistance then
        ClearESPForPlayer(player)
        return
    end

    if not ESPDrawings[player] then
        ESPDrawings[player] = {}
    end

    local drawings = ESPDrawings[player]

    -- Box ESP
    if ESPConfig.BoxESP then
        local head = character:FindFirstChild("Head")
        if not head then head = root end
        local headPos = Camera:WorldToViewportPoint(head.Position)
        local rootPos = Camera:WorldToViewportPoint(root.Position)

        local height = math.abs(rootPos.Y - headPos.Y) * 2.2
        local width = height / 2

        local topLeft = Vector2.new(headPos.X - width / 2, headPos.Y - height * 0.1)
        local topRight = Vector2.new(headPos.X + width / 2, headPos.Y - height * 0.1)
        local bottomLeft = Vector2.new(headPos.X - width / 2, rootPos.Y + height * 0.4)
        local bottomRight = Vector2.new(headPos.X + width / 2, rootPos.Y + height * 0.4)

        if not drawings.BoxLines then
            drawings.BoxLines = {}
            for i = 1, 4 do
                drawings.BoxLines[i] = CreateDrawing("Line", {
                    Thickness = ESPConfig.BoxThickness,
                    Color = ESPConfig.BoxColor,
                    Transparency = 1,
                })
            end
        end

        local lines = {
            {topLeft, topRight},
            {topRight, bottomRight},
            {bottomRight, bottomLeft},
            {bottomLeft, topLeft},
        }

        for i, line in pairs(lines) do
            local d = drawings.BoxLines[i]
            if d then
                d.From = line[1]
                d.To = line[2]
                d.Color = ESPConfig.BoxColor
                d.Thickness = ESPConfig.BoxThickness
                d.Visible = true
            end
        end
    elseif drawings.BoxLines then
        for _, d in pairs(drawings.BoxLines) do
            pcall(function() d.Visible = false end)
        end
    end

    -- Skeleton ESP
    if ESPConfig.SkeletonESP then
        local skeletonParts = GetSkeletonParts(character)
        if not drawings.SkeletonLines then
            drawings.SkeletonLines = {}
        end

        for i, parts in pairs(skeletonParts) do
            if not drawings.SkeletonLines[i] then
                drawings.SkeletonLines[i] = CreateDrawing("Line", {
                    Thickness = ESPConfig.SkeletonThickness,
                    Color = ESPConfig.SkeletonColor,
                    Transparency = 1,
                })
            end
            local part1, part2 = parts[1], parts[2]
            if part1 and part2 then
                local pos1 = Camera:WorldToViewportPoint(part1.Position)
                local pos2 = Camera:WorldToViewportPoint(part2.Position)
                local d = drawings.SkeletonLines[i]
                if d then
                    d.From = Vector2.new(pos1.X, pos1.Y)
                    d.To = Vector2.new(pos2.X, pos2.Y)
                    d.Color = ESPConfig.SkeletonColor
                    d.Thickness = ESPConfig.SkeletonThickness
                    d.Visible = true
                end
            end
        end
    elseif drawings.SkeletonLines then
        for _, d in pairs(drawings.SkeletonLines) do
            pcall(function() d.Visible = false end)
        end
    end

    -- Text ESP (Name, Health, Distance, Tool, Team)
    local textLines = {}
    local yOffset = 0

    if ESPConfig.ShowName then
        table.insert(textLines, {text = player.Name, color = ESPConfig.NameColor})
    end
    if ESPConfig.ShowHealth then
        local hp = math.floor(humanoid.Health)
        local maxHp = math.floor(humanoid.MaxHealth)
        table.insert(textLines, {text = hp .. "/" .. maxHp, color = ESPConfig.HealthColor})
    end
    if ESPConfig.ShowDistance then
        table.insert(textLines, {text = math.floor(distance) .. "m", color = ESPConfig.DistanceColor})
    end
    if ESPConfig.ShowTool then
        local tool = character:FindFirstChildWhichIsA("Tool")
        if tool then
            table.insert(textLines, {text = tool.Name, color = ESPConfig.ToolColor})
        end
    end
    if ESPConfig.ShowTeam then
        if player.Team then
            table.insert(textLines, {text = player.Team.Name, color = ESPConfig.TeamColor})
        end
    end

    if #textLines > 0 then
        if not drawings.Texts then
            drawings.Texts = {}
        end

        local basePos = Vector2.new(rootPos.X, rootPos.Y - height / 2 - 10) if height then
            basePos = Vector2.new(rootPos.X, rootPos.Y - 60)
        else
            basePos = Vector2.new(rootPos.X, rootPos.Y - 60)
        end

        for i, lineData in pairs(textLines) do
            if not drawings.Texts[i] then
                drawings.Texts[i] = CreateDrawing("Text", {
                    Text = lineData.text,
                    Color = lineData.color,
                    Size = ESPConfig.TextSize,
                    Center = true,
                    Outline = true,
                    Font = 2,
                })
            end
            local d = drawings.Texts[i]
            if d then
                d.Text = lineData.text
                d.Color = lineData.color
                d.Size = ESPConfig.TextSize
                d.Position = Vector2.new(rootPos.X, rootPos.Y - 60 - (#textLines - i) * 15)
                d.Visible = true
            end
        end

        -- Hide extra texts
        for i = #textLines + 1, #drawings.Texts do
            if drawings.Texts[i] then
                pcall(function() drawings.Texts[i].Visible = false end)
            end
        end
    elseif drawings.Texts then
        for _, d in pairs(drawings.Texts) do
            pcall(function() d.Visible = false end)
        end
    end
end

local function ClearAllESP()
