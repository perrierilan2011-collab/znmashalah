-- =====================================================
-- COLOR SERIALISATION
-- =====================================================

local function SerializeColor(color)
    return {R = color.R, G = color.G, B = color.B}
end

local function DeserializeColor(data)
    if data and data.R and data.G and data.B then
        return Color3.new(data.R, data.G, data.B)
    end
    return nil
end

