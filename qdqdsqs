local SaveManager = {}
SaveManager.Folder = "ZNKHubConfig"
SaveManager.File = "Config.json"

function SaveManager:GetPath()
    return self.Folder .. "/" .. self.File
end

function SaveManager:Save(config)
    local json = HttpService:JSONEncode(config)
    if writefile then
        if not isfolder(self.Folder) then makefolder(self.Folder) end
        writefile(self:GetPath(), json)
    end
end

function SaveManager:Load()
    if readfile and isfile(self:GetPath()) then
        local ok, result = pcall(function()
            return HttpService:JSONDecode(readfile(self:GetPath()))
        end)
        if ok then return result end
    end
    return nil
end

