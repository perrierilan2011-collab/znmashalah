-- =====================================================
-- CROSSHAIR - STAR OF DAVID
-- =====================================================

local CrosshairDrawings = {}
local CrosshairRotation = 0

local function CreateCrosshairDrawings()
    if not DrawingAPI then return end
    if CrosshairDrawings.lines then return end

    CrosshairDrawings.lines = {}
    -- 6 lines for Star of David (3 per triangle)
    for i = 1, 6 do
        CrosshairDrawings.lines[i] = CreateDrawing("Line", {
            Thickness = CrosshairConfig.Thickness,
            Color = CrosshairConfig.Color,
            Transparency = 1 - CrosshairConfig.Transparency,
        })
    end
end

local function UpdateCrosshair(dt)
    if not CrosshairConfig.Enabled or not DrawingAPI then
        if CrosshairDrawings.lines then
            for _, line in pairs(CrosshairDrawings.lines) do
                pcall(function() line.Visible = false end)
            end
        end
        return
    end

    CreateCrosshairDrawings()
    if not CrosshairDrawings.lines then return end

    if CrosshairConfig.Rotate then
        CrosshairRotation = CrosshairRotation + dt * 30
    end

    local centerX = Camera.ViewportSize.X / 2
    local centerY = Camera.ViewportSize.Y / 2
    local size = CrosshairConfig.Size

    -- Triangle 1 (pointing up)
    local t1 = {}
    local angleOffset1 = CrosshairRotation
    for i = 0, 2 do
        local angle = math.rad(angleOffset1 + i * 120 - 90)
        table.insert(t1, Vector2.new(centerX + math.cos(angle) * size, centerY + math.sin(angle) * size))
    end

    -- Triangle 2 (pointing down)
    local t2 = {}
    local angleOffset2 = CrosshairRotation + 60
    for i = 0, 2 do
        local angle = math.rad(angleOffset2 + i * 120 - 90)
        table.insert(t2, Vector2.new(centerX + math.cos(angle) * size, centerY + math.sin(angle) * size))
    end

    -- Draw Triangle 1
    local lines = CrosshairDrawings.lines
    lines[1].From = t1[1] lines[1].To = t1[2]
    lines[2].From = t1[2] lines[2].To = t1[3]
    lines[3].From = t1[3] lines[3].To = t1[1]

    -- Draw Triangle 2
    lines[4].From = t2[1] lines[4].To = t2[2]
    lines[5].From = t2[2] lines[5].To = t2[3]
    lines[6].From = t2[3] lines[6].To = t2[1]

    for _, line in pairs(lines) do
        line.Color = CrosshairConfig.Color
        line.Thickness = CrosshairConfig.Thickness
        line.Transparency = 1 - CrosshairConfig.Transparency
        line.Visible = true
    end
end

