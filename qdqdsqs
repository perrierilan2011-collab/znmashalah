local function LoadSavedConfig()
    local saved = SaveManager:Load()
    if not saved then return end

    if saved.Aimbot then
        for k, v in pairs(saved.Aimbot) do
            if k == "FOVColor" then
                local c = DeserializeColor(v)
                if c then AimbotConfig.FOVColor = c end
            elseif AimbotConfig[k] ~= nil then
                AimbotConfig[k] = v
            end
        end
        if saved.Aimbot.Keybind then
            AimbotConfig.Keybind = Enum.KeyCode[saved.Aimbot.Keybind] or Enum.KeyCode.E
        end
    end

    if saved.ESP then
        for k, v in pairs(saved.ESP) do
            if k:find("Color") then
                local c = DeserializeColor(v)
                if c then ESPConfig[k] = c end
            elseif ESPConfig[k] ~= nil then
                ESPConfig[k] = v
            end
        end
    end

    if saved.Crosshair then
        for k, v in pairs(saved.Crosshair) do
            if k == "Color" or k == "OutlineColor" then
                local c = DeserializeColor(v)
                if c then CrosshairConfig[k] = c end
            elseif CrosshairConfig[k] ~= nil then
                CrosshairConfig[k] = v
            end
        end
    end

    if saved.Movement then
        for k, v in pairs(saved.Movement) do
            if MovementConfig[k] ~= nil then MovementConfig[k] = v end
        end
    end

    if saved.Misc then
        for k, v in pairs(saved.Misc) do
            if k == "MenuKeybind" then
                MiscConfig.MenuKeybind = Enum.KeyCode[v] or Enum.KeyCode.RightShift
            elseif MiscConfig[k] ~= nil then
                MiscConfig[k] = v
            end
        end
    end
end

