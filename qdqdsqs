local function IsPlayerVisible(player)
    if not AimbotConfig.WallCheck then return true end
    local character = player.Character
    if not character then return false end
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    local camPos = Camera.CFrame.Position
    local rootPos = root.Position
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = {character, LocalPlayer.Character}
    local result = Workspace:Raycast(camPos, rootPos - camPos, rayParams)
    return result == nil
end

local function GetClosestPlayerToCrosshair()
    local closestPlayer = nil
    local shortestDistance = AimbotConfig.FOV
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if not (AimbotConfig.TeamCheck and player.Team == LocalPlayer.Team) then
                local character = player.Character
                if character then
                    local targetPart = character:FindFirstChild(AimbotConfig.TargetPart)
                    if not targetPart then
                        targetPart = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
                    end
                    if targetPart then
                        local humanoid = character:FindFirstChild("Humanoid")
                        if humanoid and humanoid.Health > 0 then
                            local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                            if onScreen then
                                local distance = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                                if distance < shortestDistance then
                                    if IsPlayerVisible(player) then
                                        shortestDistance = distance
                                        closestPlayer = player
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    return closestPlayer
end

local function UpdateAimbot()
    if not AimbotActive or not AimbotConfig.Enabled then return end
    local target = GetClosestPlayerToCrosshair()
    if target then
        local character = target.Character
        if character then
            local targetPart = character:FindFirstChild(AimbotConfig.TargetPart)
            if not targetPart then
                targetPart = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
            end
            if targetPart then
                local targetPos = targetPart.Position
                local camPos = Camera.CFrame.Position
                local direction = (targetPos - camPos).Unit
                local smoothFactor = 1 - AimbotConfig.Smoothing
                local newLook = CFrame.new(camPos, camPos + direction:Lerp(Camera.CFrame.LookVector, smoothFactor))
                Camera.CFrame = Camera.CFrame:Lerp(newLook, AimbotConfig.Smoothing)
            end
        end
    end
end

